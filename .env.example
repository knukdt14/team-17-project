# 이 파일을 복사해서 .env로 저장하고 실제 키를 채워넣으세요.
# docker-compose.yml의 model 서비스가 env_file로 이 값들을 컨테이너 환경변수로 주입합니다.

UPSTAGE_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
HF_TOKEN=

# 필요시 모델명 override (기본값은 각 코드 파일에 정의되어 있음)
# GEMINI_MODEL=gemini-3.6-flash
# GROQ_LLAMA_MODEL=llama-3.3-70b-versatile
